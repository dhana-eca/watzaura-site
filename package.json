{
  "name": "watzaura-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "og": "node scripts/og.mjs",
    "prebuild": "node -e \"try{require.resolve('@resvg/resvg-js');require('child_process').execSync('node scripts/og.mjs',{stdio:'inherit'})}catch{console.log('og: skipped (dev deps not installed)')}\"",
    "e2e:waitlist": "node scripts/waitlist-e2e.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/node": "^9.5.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "postgres": "^3.4.9",
    "resend": "^6.28.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "chrome-launcher": "^1.2.1",
    "fontkit": "^2.0.4",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wawoff2": "^2.0.1"
  }
