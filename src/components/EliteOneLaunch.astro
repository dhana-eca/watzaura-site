---
/**
 * Elite One Cricket: Elite Cricket Academy's edition of the Arenzo app,
 * submitted to the App Store and Google Play on 30 Oct 2026. `strip` is the
 * one-line announcement under the home hero; `full` is the section on
 * /built-at-elite with the store screenshots (demo academy, invented family).
 *
 * When the stores approve it, set `eliteOne.live = true` and the store links
 * replace "In review".
 */
import { Image } from 'astro:assets';
import icon from '@/assets/elite-one/play-icon-512.png';
import home from '@/assets/elite-one/01-home.png';
import book from '@/assets/elite-one/02-book.png';
import memberships from '@/assets/elite-one/03-memberships.png';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { eliteOne } from '@/lib/site';

interface Props { variant?: 'strip' | 'full' }
const { variant = 'full' } = Astro.props;

const shots = [
  { src: home, alt: 'Elite One Cricket Home screen: the next session, credits, membership and upcoming bookings for an invented family.' },
  { src: book, alt: 'Elite One Cricket Book screen: choose a lane or bowling machine, the day, the length and the lane.' },
  { src: memberships, alt: 'Elite One Cricket Memberships screen: two active squad memberships with a Manage button each.' },
];
const status = eliteOne.live ? 'Live on the App Store and Google Play' : 'Submitted 30 Oct 2026 · In review';
---

{variant === 'strip' ? (
  <aside class="border-b border-line bg-surface/60" aria-label="Elite One Cricket announcement">
    <div class="wrap flex flex-col gap-4 py-5 sm:flex-row sm:items-center">
      <Image src={icon} alt="" width={96} class="h-12 w-12 shrink-0 rounded-xl" />
      <p class="text-[0.9375rem] leading-snug text-ink-2">
        <span class="ui-label mr-2 text-brass">New</span>
        <strong>Elite One Cricket</strong>, the first academy app built on Arenzo, is with the App Store and Google Play for review.
      </p>
      <a href={eliteOne.post} class="link link-arrow shrink-0 text-[0.9375rem] sm:ml-auto">Read the story</a>
    </div>
  </aside>
) : (
  <Section id="elite-one">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <Image src={icon} alt="The Elite One Cricket app icon: the academy's crown and ball on cream." width={160} class="mb-8 h-20 w-20 rounded-2xl" />
        <SectionHead
          eyebrow="Our first app in the stores"
          heading="Elite One Cricket."
          body="Elite Cricket Academy's own app, built on Arenzo by Watzaura. Families book lanes and bowling machines, manage memberships, pay, and follow their child's training from their phone. Coaches mark attendance and rate players from the same app."
          size="t-2"
        />
        <p class="ui-label mt-8 text-brass">{status}</p>
        {eliteOne.live ? (
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={eliteOne.appStore} class="btn btn-primary">App Store</a>
            <a href={eliteOne.googlePlay} class="btn btn-secondary">Google Play</a>
          </div>
        ) : (
          <p class="mt-3 max-w-md text-[0.9375rem] text-muted">Both stores have it. Elite families get it as soon as Apple and Google approve, with the same sign-in they already use.</p>
        )}
        <a href={eliteOne.post} class="link link-arrow mt-6 inline-block text-[0.9375rem]">How we got here</a>
      </div>
      <ul class="grid grid-cols-3 gap-3 sm:gap-5 lg:col-span-7">
        {shots.map((s, i) => (
          <li class:list={[i === 1 && 'translate-y-6']}>
            <Image src={s.src} alt={s.alt} width={420} class="w-full rounded-[1.25rem] border border-line-strong shadow-[0_24px_48px_-24px_rgb(0_0_0/0.8)]" />
          </li>
        ))}
      </ul>
    </div>
    <p class="mt-14 text-[0.75rem] text-muted">Store screenshots from the demo academy, with an invented family. Not customer data.</p>
  </Section>
)}
