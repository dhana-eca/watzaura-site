---
/** Eyebrow + heading + optional lede/body, left-aligned. `number` adds a large faint numeral beside it. */
interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  lede?: string;
  level?: 'h2' | 'h3';
  size?: 't-1' | 't-2' | 't-3';
  class?: string;
  narrow?: boolean;
  number?: string;
}
const { eyebrow, heading, body, lede, level = 'h2', size = 't-1', class: className = '', narrow = true, number } = Astro.props;
const Tag = level;
---

<div class:list={['relative', narrow && 'max-w-3xl', className]}>
  {number && <span class="numeral mb-6 block" aria-hidden="true">{number}</span>}
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  {heading && <Tag class={size}>{heading}</Tag>}
  {lede && <p class="lede mt-5">{lede}</p>}
  {body && <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">{body}</p>}
  <slot />
</div>
