---
/** Development: the player profile and intake baseline. Synthetic data. */
const fields: Array<[string, string]> = [
  ['Playing role', 'Batter'], ['Batting', 'Right-hand'], ['Bowling', 'Right-arm off-spin'], ['Squad', 'Junior Elite'],
  ['Club', 'Werribee CC · U13'], ['School', 'St Aidan\'s'], ['Years playing', '3'], ['Focus areas', 'Batting · Fitness'],
];
const self: Array<[string, number]> = [['Technique', 5], ['Fitness', 6], ['Awareness', 4], ['Mental', 5], ['Nutrition', 6], ['Leadership', 4]];
---

<div class="ui-frame grid md:grid-cols-[1fr_1fr]" role="img" aria-label="Illustration of a Plinth player profile at intake: role, styles, squad, club and goals on the left; the athlete's own baseline self-ratings and the coach's assessment on the right.">
  <div class="border-b border-line p-4 md:border-b-0 md:border-r">
    <p class="ui-label">Player profile</p>
    <p class="mt-0.5 font-display text-[1.125rem] font-medium text-ink opsz-48">Priya N.</p>
    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-[0.75rem]">
      {fields.map(([k, v]) => <div><dt class="text-muted">{k}</dt><dd class="text-ink">{v}</dd></div>)}
    </dl>
    <div class="mt-3 border-t border-line pt-3 text-[0.75rem]">
      <p class="text-muted">Athlete's goal</p>
      <p class="text-ink-2">"Open the batting for the U15s next season and score a fifty."</p>
    </div>
  </div>
  <div class="p-4">
    <p class="ui-label">Intake · self-rating</p>
    <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[0.75rem]">
      {self.map(([k, v]) => (
        <li class="grid grid-cols-[4.5rem_1fr_1rem] items-center gap-2"><span class="text-ink-2">{k}</span><span class="h-1 rounded-full bg-line"><span class="block h-1 rounded-full bg-line-strong" style={`width:${v * 10}%`}></span></span><span class="ui-num text-right text-ink">{v}</span></li>
      ))}
    </ul>
    <div class="mt-3 border-t border-line pt-3 text-[0.75rem]">
      <p class="ui-label">Coach baseline · Coach Sam</p>
      <p class="mt-1 leading-snug text-ink-2">Compact technique, late on the short ball, strong off the pads. Fitness ahead of the squad.</p>
      <ol class="mt-2 grid gap-1">
        {['Front-foot drive shape', 'Short-ball decision', 'Running between wickets'].map((p, i) => <li class="flex gap-2"><span class="ui-num text-brass">{i + 1}</span><span class="text-ink">{p}</span></li>)}
      </ol>
      <div class="mt-2 grid grid-cols-3 gap-2">
        {[['3 months', 'Drive block done'], ['12 months', 'U15 squad'], ['Long term', 'Premier pathway']].map(([k, v]) => <div><p class="text-muted">{k}</p><p class="text-ink">{v}</p></div>)}
      </div>
      <p class="mt-2 text-muted">Medical · held separately · 1 note</p>
    </div>
  </div>
</div>
