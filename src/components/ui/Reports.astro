---
/** Operations: sales by centre by day for a week. Invented figures. */
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const centres = [
  { name: 'Hoppers', v: [1240, 1810, 1420, 1990, 1560, 3120, 2480], cls: 'fill-brass' },
  { name: 'Pakenham', v: [860, 1210, 990, 1330, 1120, 2260, 1740], cls: 'fill-brass/45' },
];
const max = 3400;
const w = 420, h = 150, pad = 8;
const bw = (w - pad * 2) / days.length;
const fmt = (n: number) => 'A$' + n.toLocaleString('en-AU');
const tot = (c: number[]) => c.reduce((a, b) => a + b, 0);
---

<div class="ui-frame p-4" role="img" aria-label="Illustration of a Plinth report: sales by day for two Australian centres over one week, with weekly totals and a program roll count. Figures invented.">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div><p class="ui-label">Reports · Sales by centre</p><p class="mt-0.5 font-medium text-ink">Week of 13 Oct · AUD</p></div>
    <ul class="flex gap-4 text-[0.75rem]">{centres.map((c) => <li class="flex items-center gap-1.5"><span class:list={['size-2 rounded-[2px]', c.cls === 'fill-brass' ? 'bg-brass' : 'bg-brass/45']}></span>{c.name}</li>)}</ul>
  </div>
  <svg viewBox={`0 0 ${w} ${h}`} class="mt-3 h-auto w-full" aria-hidden="true">
    {[0.25, 0.5, 0.75, 1].map((g) => <line x1={pad} x2={w - pad} y1={h - 18 - (h - 30) * g} y2={h - 18 - (h - 30) * g} stroke="var(--color-line)" stroke-dasharray="2 4" />)}
    {days.map((d, i) => (
      <>
        {centres.map((c, k) => {
          const bh = ((h - 30) * c.v[i]) / max;
          return <rect x={pad + i * bw + 8 + k * ((bw - 16) / 2)} y={h - 18 - bh} width={(bw - 16) / 2 - 2} height={bh} rx="2" class={c.cls} />;
        })}
        <text x={pad + i * bw + bw / 2} y={h - 4} text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-muted)">{d}</text>
      </>
    ))}
  </svg>
  <dl class="mt-3 grid grid-cols-3 gap-3 border-t border-line pt-3 text-[0.75rem]">
    {centres.map((c) => <div><dt class="ui-label">{c.name} · week</dt><dd class="ui-num mt-0.5 text-ink">{fmt(tot(c.v))}</dd></div>)}
    <div><dt class="ui-label">Holiday program roll</dt><dd class="mt-0.5 text-ink"><span class="ui-num">14</span> / 16 places</dd></div>
  </dl>
</div>
