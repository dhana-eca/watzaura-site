---
/** Tiny line chart for a rating series. Decorative; the numbers sit in text beside it. */
interface Props { values: number[]; max?: number; class?: string }
const { values, max = 10, class: className = '' } = Astro.props;
const w = 100, h = 40, pad = 3;
const step = (w - pad * 2) / Math.max(1, values.length - 1);
const pts = values.map((v, i) => [pad + i * step, h - pad - (v / max) * (h - pad * 2)] as const);
const d = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const last = pts[pts.length - 1];
---

<svg viewBox={`0 0 ${w} ${h}`} class={className} aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <path d={d} fill="none" stroke="var(--color-brass)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
  <circle cx={last[0]} cy={last[1]} r="2.5" fill="var(--color-brass-light)" />
</svg>
