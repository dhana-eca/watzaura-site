---
/** Operations visual: a family account's money view. Synthetic data. */
---

<div class="ui-frame p-4" role="img" aria-label="Illustration of a family account in Plinth: a direct-debit membership with its next charge date, a credit wallet and recent payments.">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="ui-label">Family account</p>
      <p class="mt-0.5 font-display text-[1.125rem] font-medium leading-tight text-ink opsz-48">The Nair family</p>
      <p class="text-[0.75rem] text-muted">2 players · Hoppers Crossing</p>
    </div>
    <span class="rounded-full border border-ok/40 px-2 py-0.5 text-[0.6875rem] text-ok">Active</span>
  </div>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-md border border-line p-3">
      <p class="ui-label">Membership</p>
      <p class="mt-1 text-ink">Junior Group · 2 sessions / week</p>
      <p class="text-[0.75rem] text-muted">Direct debit · A$<span class="ui-num">58</span> / fortnight · next <span class="ui-num">21 Oct</span></p>
      <p class="mt-2 text-[0.75rem] text-ink-2">Priya N. · Tue &amp; Sat</p>
    </div>
    <div class="rounded-md border border-line p-3">
      <p class="ui-label">Credit wallet</p>
      <p class="mt-1 text-ink"><span class="ui-num">4</span> session credits</p>
      <p class="text-[0.75rem] text-muted">Settle when a session is delivered</p>
      <p class="mt-2 text-[0.75rem] text-ink-2">Rohan N. · casual coaching</p>
    </div>
  </div>
  <table class="mt-4 w-full text-[0.75rem]">
    <thead><tr class="ui-label text-left"><th class="pb-1.5 font-medium">Recent</th><th class="pb-1.5 font-medium">Method</th><th class="pb-1.5 text-right font-medium">Status</th></tr></thead>
    <tbody class="[&_td]:border-t [&_td]:border-line [&_td]:py-1.5">
      <tr><td class="text-ink">Holiday program · Rohan · 3 days</td><td class="text-muted">Card</td><td class="text-right text-ok">Paid</td></tr>
      <tr><td class="text-ink">Membership · fortnight</td><td class="text-muted">Direct debit</td><td class="text-right text-ok">Collected</td></tr>
      <tr><td class="text-ink">Lane · Machine A · 30 min</td><td class="text-muted">Credits</td><td class="text-right text-ink-2">Settled</td></tr>
    </tbody>
  </table>
</div>
