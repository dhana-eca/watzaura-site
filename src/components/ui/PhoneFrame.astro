---
/**
 * Mobile visual: a phone showing the coach's day or the parent's view.
 * Synthetic data. Buttons are inert and hidden from assistive tech.
 */
interface Props { view?: 'coach' | 'parent' | 'athlete'; class?: string }
const { view = 'coach', class: className = '' } = Astro.props;
const labels = {
  coach: "Illustration of the Plinth coach app on a phone: today's roster with attendance marked, and a rating ready to write.",
  parent: "Illustration of the Plinth parent app on a phone: the next session, the child's latest coach rating and the membership.",
  athlete: "Illustration of the Plinth athlete app on a phone: this week's focus, the assigned program, the training diary and the next match.",
};
const label = labels[view];
const roster: Array<[string, boolean]> = [['Priya N.', true], ['Arjun V.', true], ['Maya T.', true], ['Rohan N.', false], ['Zac L.', true]];
---

<div class:list={['mx-auto w-[15.5rem] rounded-[2rem] border border-line-strong bg-ground p-2 shadow-[0_40px_80px_-40px_rgb(0_0_0/0.9)]', className]} role="img" aria-label={label}>
  <div class="rounded-[1.5rem] border border-line bg-surface">
    <div class="flex items-center justify-between px-5 pt-3 text-[0.625rem] text-muted">
      <span class="ui-num">9:41</span>
      <span class="h-4 w-14 rounded-full bg-ground"></span>
      <span class="ui-num">●●●</span>
    </div>
    {view === 'coach' ? (
      <div class="px-4 pb-5 pt-3 text-[0.75rem]">
        <p class="ui-label">Today · Hoppers</p>
        <p class="mt-0.5 font-display text-[1.0625rem] font-medium text-ink opsz-48">Coach Sam</p>
        <div class="mt-3 rounded-md border border-brass/60 bg-brass/10 p-2.5">
          <div class="flex justify-between"><span class="font-medium text-ink">U13 Squad</span><span class="ui-num text-ink-2">4:00 – 5:00</span></div>
          <p class="text-[0.6875rem] text-muted">Lane 1–2 · 8 players</p>
          <ul class="mt-2 grid gap-1">
            {roster.map(([n, here]) => (
              <li class="flex items-center justify-between">
                <span class="text-ink-2">{n}</span>
                <span class:list={['rounded-[2px] px-1.5 py-0.5 text-[0.625rem]', here ? 'bg-brass text-ground' : 'border border-line-strong text-muted']}>{here ? 'Here' : 'Away'}</span>
              </li>
            ))}
            <li class="text-[0.6875rem] text-muted">+3 more</li>
          </ul>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="font-medium text-ink">Priya N. · 1:1</span><span class="ui-num text-ink-2">5:30</span></div>
          <p class="text-[0.6875rem] text-muted">Lane 1 · Batting</p>
          <span class="mt-2 block w-full rounded-[4px] bg-brass py-1.5 text-center text-[0.6875rem] font-medium text-ground" aria-hidden="true">Write this week's rating</span>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="font-medium text-ink">Senior HP</span><span class="ui-num text-ink-2">6:30</span></div>
          <p class="text-[0.6875rem] text-muted">Lane 2–3 · 5 players</p>
        </div>
      </div>
    ) : view === 'athlete' ? (
      <div class="px-4 pb-5 pt-3 text-[0.75rem]">
        <p class="ui-label">My pathway · Batting</p>
        <p class="mt-0.5 font-display text-[1.0625rem] font-medium text-ink opsz-48">Dev K.</p>
        <div class="mt-3 rounded-md border border-brass/60 bg-brass/10 p-2.5">
          <p class="ui-label">This week's focus</p>
          <p class="mt-1 leading-snug text-ink-2">Leave drill before hitting — shot selection outside off.</p>
          <p class="mt-1 text-[0.6875rem] text-muted">Coach Sam · Sat</p>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="text-ink">Front-foot drive block</span><span class="ui-num text-ink-2">3 / 5</span></div>
          <p class="text-[0.6875rem] text-muted">Next: Leave drill · 20 balls</p>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="text-ink">Diary</span><span class="ui-num text-ink-2">2 this week</span></div>
          <p class="text-[0.6875rem] text-muted">Sun · throw-downs · 40 min</p>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="text-ink">Next match</span><span class="ui-num text-ink-2">Sat 8:30</span></div>
          <p class="text-[0.6875rem] text-muted">v Hoppers Crossing U15 · home</p>
        </div>
        <span class="mt-2 block w-full rounded-[4px] bg-brass py-1.5 text-center text-[0.6875rem] font-medium text-ground" aria-hidden="true">Log training</span>
      </div>
    ) : (
      <div class="px-4 pb-5 pt-3 text-[0.75rem]">
        <p class="ui-label">The Nair family</p>
        <p class="mt-0.5 font-display text-[1.0625rem] font-medium text-ink opsz-48">Priya · Rohan</p>
        <div class="mt-3 rounded-md border border-line p-2.5">
          <p class="ui-label">Next</p>
          <div class="flex justify-between"><span class="font-medium text-ink">U13 Squad · Priya</span><span class="ui-num text-ink-2">Tue 4:00</span></div>
          <p class="text-[0.6875rem] text-muted">Hoppers · Lane 1–2 · Coach Sam</p>
        </div>
        <div class="mt-2 rounded-md border border-brass/60 bg-brass/10 p-2.5">
          <p class="ui-label">This week · Priya · Batting</p>
          <p class="mt-1 leading-snug text-ink-2"><span class="text-brass">Highlight</span> — held shape on the front-foot drive.</p>
          <p class="mt-1 leading-snug text-ink-2"><span class="text-brass">Next</span> — shot selection outside off.</p>
        </div>
        <div class="mt-2 rounded-md border border-line p-2.5">
          <div class="flex justify-between"><span class="text-ink">Membership</span><span class="text-ok">Active</span></div>
          <p class="text-[0.6875rem] text-muted">Next debit 21 Oct · 4 credits</p>
        </div>
        <span class="mt-2 block w-full rounded-[4px] border border-line-strong py-1.5 text-center text-[0.6875rem] font-medium text-ink" aria-hidden="true">Book a lane</span>
      </div>
    )}
  </div>
</div>
