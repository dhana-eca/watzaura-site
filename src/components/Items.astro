---
/**
 * The workhorse list: a grid of titled items separated by hairlines rather than
 * cards. `cols` controls the desktop column count; items stack on mobile.
 */
interface Item { title: string; body?: string; meta?: string; href?: string; points?: string[] }
interface Props {
  items: readonly Item[];
  cols?: 2 | 3 | 4;
  class?: string;
  /** Show a mono index (01, 02…) when items carry no meta. */
  numbered?: boolean;
  headingLevel?: 'h3' | 'h4';
}
const { items, cols = 3, class: className = '', numbered = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const grid = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[cols];
---

<ul class:list={['grid gap-x-8 gap-y-10 border-t border-line pt-8', grid, className]}>
  {items.map((item, i) => {
    const meta = item.meta ?? (numbered ? String(i + 1).padStart(2, '0') : undefined);
    const Inner = (
      <>
        {meta && <p class="ui-label mb-3 text-brass">{meta}</p>}
        <H class="t-3 text-ink">{item.href ? <a href={item.href} class="transition-colors hover:text-brass-light">{item.title}</a> : item.title}</H>
        {item.body && <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{item.body}</p>}
        {item.points && (
          <ul class="mt-4 grid gap-1.5 text-[0.9375rem] text-ink-2">
            {item.points.map((pt) => (
              <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block size-1.5 flex-none bg-brass" aria-hidden="true"></span><span>{pt}</span></li>
            ))}
          </ul>
        )}
        {item.href && <a href={item.href} class="link link-arrow mt-4 inline-block text-[0.9375rem]">{item.title} in detail</a>}
      </>
    );
    return <li class="min-w-0">{Inner}</li>;
  })}
</ul>
