---
/**
 * Page hero. Left column: eyebrow, heading, lede, CTAs. Slot: a rendered
 * product visual, beside ('split') or below ('stack') the text. Never 100vh —
 * sized by its content. `backdrop` adds the living lane grid behind it.
 */
import HeroGrid from './HeroGrid.astro';
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
  ctas?: readonly { label: string; href: string }[];
  layout?: 'split' | 'stack' | 'text';
  size?: 't-hero' | 't-1';
  backdrop?: boolean;
}
const { eyebrow, heading, lede, ctas = [], layout = 'text', size = 't-hero', backdrop = false } = Astro.props;
const hasVisual = layout !== 'text';
---

<section class:list={['relative overflow-hidden border-b border-line', backdrop && 'textured']}>
  {backdrop && <HeroGrid />}
  <div class:list={['wrap relative grid gap-12 py-16 md:py-24', layout === 'split' && 'lg:grid-cols-12 lg:items-center lg:gap-10']}>
    <div class:list={[layout === 'split' ? 'lg:col-span-6' : 'max-w-4xl']}>
      {eyebrow && <p class="eyebrow rise mb-5" style="--i:0">{eyebrow}</p>}
      <h1 class:list={[size, 'rise']} style="--i:1">{heading}</h1>
      {lede && <p class="lede rise mt-6 max-w-2xl" style="--i:2">{lede}</p>}
      {ctas.length > 0 && (
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          {ctas.map((c, i) => (
            <a href={c.href} class:list={['btn btn-lg', i === 0 ? 'btn-primary' : 'btn-secondary']}>{c.label}</a>
          ))}
        </div>
      )}
    </div>
    {hasVisual && (
      <div class:list={['rise relative min-w-0', layout === 'split' && 'lg:col-span-6']} style="--i:4">
        {backdrop && <div class="glow" aria-hidden="true"></div>}
        <div class="relative"><slot /></div>
      </div>
    )}
  </div>
</section>
