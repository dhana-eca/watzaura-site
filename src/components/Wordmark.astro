---
/**
 * Wordmarks: the name set in Fraunces at display optical size. Watzaura carries
 * a single brass block taken from the lane grid; Arenzo carries the Arch mark
 * (chosen 30 Oct 2026), the same geometry as the app icon.
 */
interface Props {
  which?: 'watzaura' | 'arenzo';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { which = 'watzaura', size = 'md', class: className = '' } = Astro.props;
const text = which === 'arenzo' ? 'Arenzo' : 'Watzaura';
const sizes = { sm: 'text-[1.125rem]', md: 'text-[1.375rem]', lg: 'text-[2rem]' };
---

<span class:list={['inline-flex items-center gap-2 font-display text-ink leading-none', sizes[size], className]} style="font-variation-settings:'opsz' 144; font-weight:520; letter-spacing:-0.02em">
  {which === 'arenzo'
    ? <svg class="inline-block h-[0.78em] w-auto" viewBox="136 150 240 214" aria-hidden="true"><path d="M168 356V252a88 88 0 0 1 176 0v104" fill="none" stroke="currentColor" class="text-brass" stroke-width="32" /><rect x="226" y="280" width="60" height="76" rx="6" fill="#f2c58c" /></svg>
    : <span class="inline-block size-[0.42em] bg-brass translate-y-[0.04em]" aria-hidden="true"></span>}
  <span>{text}</span>
</span>
