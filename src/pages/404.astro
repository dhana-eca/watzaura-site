---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow mb-5">404</p>
    <h1 class="t-1">There is nothing at this address.</h1>
    <p class="lede mt-6 max-w-xl">The page may have moved, or the link was wrong. Arenzo, our product, now has its own site at arenzo.app.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="https://arenzo.app" class="btn btn-secondary">Visit arenzo.app</a>
    </div>
  </section>
</Base>
