---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';

const { data } = (await getEntry('pages', 'switch'))!;
const s = data.sections;
---

<Base title={data.title} description={data.description}>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} size="t-1" />

  <Section>
    <SectionHead eyebrow={s.from.eyebrow} heading={s.from.heading} />
    <Items items={s.from.items!} cols={3} class="mt-12" />
  </Section>

  <Section tone="surface">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHead eyebrow={s.how.eyebrow} heading={s.how.heading} body={s.how.body} />
      </div>
      <ol class="lg:col-span-7">
        {s.how.items!.map((it) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 border-t border-line py-6 last:border-b md:grid-cols-[4rem_9rem_1fr] md:gap-6">
            <span class="ui-num text-[0.875rem] text-brass">{it.meta}</span>
            <h3 class="t-3 text-ink">{it.title}</h3>
            <p class="col-span-2 text-[0.9375rem] leading-relaxed text-ink-2 md:col-span-1">{it.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section tight>
    <SectionHead eyebrow={s.keep.eyebrow} heading={s.keep.heading} body={s.keep.body} size="t-2" />
  </Section>

  <CtaBand heading="Tell us what you run today." body="Name the system, the number of centres and what is not working. We will tell you honestly whether a migration is straightforward." />
</Base>
