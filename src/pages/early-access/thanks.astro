---
import Base from '@/layouts/Base.astro';
import LaneGrid from '@/components/LaneGrid.astro';
---

<Base title="Request received" description="Your early-access request for Plinth has been received." noindex>
  <section class="border-b border-line">
    <div class="wrap grid gap-10 py-20 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5">Early access</p>
        <h1 class="t-1">Thank you — we have your request.</h1>
        <p class="lede mt-6 max-w-xl">A confirmation is on its way to your inbox. One of the people who built Plinth will read your request and reply — there is no automated sequence after this.</p>
        <p class="mt-4 text-[0.9375rem] text-muted">If the confirmation does not arrive within a few minutes, check your spam folder, then write to <a href="mailto:hello@watzaura.com" class="link">hello@watzaura.com</a>.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/product" class="btn btn-secondary">Explore the product</a>
          <a href="/built-at-elite" class="btn btn-ghost">Read the Elite story</a>
        </div>
      </div>
      <div class="hidden justify-end lg:col-span-5 lg:flex">
        <LaneGrid class="h-auto w-56" cols={7} rows={6} cell={30} filled={[[1, 1, 2], [3, 3], [5, 0, 2], [2, 5]]} held={[]} />
      </div>
    </div>
  </section>
</Base>
