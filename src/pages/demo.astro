---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';

const { data } = (await getEntry('pages', 'demo'))!;
const s = data.sections;
const x = s.book.extra!;

/**
 * The Cal.com event to book, as its link path ("watzaura/academy-demo"), from
 * CALCOM_LINK at build time. Unset → the page offers email and phone instead.
 * Nothing from Cal.com loads until the visitor asks for it: the site promises
 * no third-party scripts on ordinary page views.
 */
const calLink = (process.env.CALCOM_LINK ?? '').trim().replace(/^https?:\/\/cal\.com\//, '').replace(/^\/+|\/+$/g, '');
const calUrl = calLink ? `https://cal.com/${calLink}` : null;
---

<Base title={data.title} description={data.description}>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} size="t-1" />

  <Section tone="surface" id="book">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHead eyebrow={s.book.eyebrow} heading={s.book.heading} body={calUrl ? s.book.body : undefined} size="t-2" />
      </div>
      <div class="min-w-0 lg:col-span-8">
        {calUrl ? (
          <div data-cal-link={calLink}>
            <div id="cal-consent" class="max-w-xl">
              <p class="text-[0.9375rem] leading-relaxed text-ink-2">{x.consent} <a href="/legal/privacy" class="link">Privacy policy</a>.</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <button type="button" id="cal-load" class="btn btn-primary btn-lg">{x.load}</button>
                <a href={calUrl} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">{x.open}</a>
              </div>
            </div>
            <div id="cal-inline" class="hidden min-h-[640px] w-full overflow-auto border border-line bg-ground"></div>
          </div>
        ) : (
          <p class="max-w-xl text-[1.0625rem] leading-relaxed text-ink-2">
            {x.unavailable}
          </p>
        )}
      </div>
    </div>
  </Section>

  <Section>
    <SectionHead eyebrow={s.cover.eyebrow} heading={s.cover.heading} size="t-2" />
    <Items items={s.cover.items!} cols={4} class="mt-8" />
  </Section>
</Base>

{calUrl && (
  <script>
    // Cal.com's own inline-embed loader, run only after the visitor clicks.
    const btn = document.getElementById('cal-load');
    btn?.addEventListener('click', () => {
      const root = document.querySelector<HTMLElement>('[data-cal-link]')!;
      const box = document.getElementById('cal-inline')!;
      document.getElementById('cal-consent')!.classList.add('hidden');
      box.classList.remove('hidden');
      const w = window as any;
      (function (C: any, A: string, L: string) {
        const p = (a: any, ar: any) => { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function (...ar: any[]) {
          const cal = C.Cal;
          if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
          if (ar[0] === L) {
            const api: any = function (...a: any[]) { p(api, a); };
            const ns = ar[1];
            api.q = api.q || [];
            if (typeof ns === 'string') { cal.ns[ns] = cal.ns[ns] || api; p(cal.ns[ns], ar); p(cal, ['initNamespace', ns]); } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(w, 'https://app.cal.com/embed/embed.js', 'init');
      w.Cal('init', 'demo', { origin: 'https://cal.com' });
      w.Cal.ns.demo('inline', { elementOrSelector: '#cal-inline', calLink: root.dataset.calLink, layout: 'month_view' });
      w.Cal.ns.demo('ui', { theme: 'dark', styles: { branding: { brandColor: '#E0A45C' } }, hideEventTypeDetails: false, layout: 'month_view' });
    }, { once: true });
  </script>
)}
