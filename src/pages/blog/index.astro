---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import { publishedPosts, formatDate } from '@/lib/posts';
import { site } from '@/lib/site';

const posts = await publishedPosts();
---

<Base title="Blog" description={`Notes from Watzaura on building ${site.product.name} and running sports academies.`}>
  <Hero
    eyebrow="Blog"
    heading="Notes from the academy floor."
    lede={`What we are building into ${site.product.name}, and what running a working academy teaches us along the way.`}
    size="t-1"
  />

  <Section tight>
    <ul class="grid max-w-3xl">
      {posts.map((p) => (
        <li class="border-t border-line py-8 last:border-b">
          <p class="ui-num text-[0.8125rem] text-muted">
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          </p>
          <h2 class="t-3 mt-2"><a href={`/blog/${p.id}`} class="transition-colors hover:text-brass-light">{p.data.title}</a></h2>
          <p class="mt-3 max-w-2xl text-[1.0625rem] text-ink-2">{p.data.description}</p>
          <a href={`/blog/${p.id}`} class="link link-arrow mt-4 inline-block text-[0.9375rem]">Read</a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-[0.9375rem] text-muted">Follow along by RSS: <a href="/rss.xml" class="link">watzaura.com/rss.xml</a></p>
  </Section>

  <CtaBand />
</Base>
