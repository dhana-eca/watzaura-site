---
/**
 * watzaura.com home: the company. The product site moved to https://arenzo.app
 * on 30 Oct 2026; every old product URL 301s there from src/pages/[...path].ts.
 */
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';
import Wordmark from '@/components/Wordmark.astro';
import PullQuote from '@/components/PullQuote.astro';
import { site } from '@/lib/site';

const { data } = (await getEntry('pages', 'company'))!;
const s = data.sections;
---

<Base title={site.name} description={data.description}>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} size="t-1" />

  <Section tone="surface">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5">Our product</p>
        <div><Wordmark which="arenzo" size="lg" /></div>
        <p class="lede mt-6 max-w-xl">
          {site.product.description} It runs our own academy's three centres in Australia and India, and is opening to other academies.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://arenzo.app" class="btn btn-primary btn-lg">Visit arenzo.app</a>
          <a href="https://arenzo.app/early-access" class="btn btn-secondary btn-lg">Request early access</a>
        </div>
      </div>
      <ul class="grid gap-3 lg:col-span-5">
        {[
          ['Operations', 'Bookings, lanes, programs, memberships and payments.', 'https://arenzo.app/product/operations'],
          ['Development', 'Assessments, coach ratings and development plans.', 'https://arenzo.app/product/development'],
          ['Mobile', 'Apps for parents, athletes and coaches.', 'https://arenzo.app/product/mobile'],
          ['Pricing', 'One monthly price per academy.', 'https://arenzo.app/pricing'],
        ].map(([title, body, href]) => (
          <li>
            <a href={href} class="block rounded-lg border border-line bg-ground/40 px-5 py-4 transition-colors hover:border-line-strong">
              <span class="block font-medium text-ink">{title}</span>
              <span class="block text-[0.9375rem] text-muted">{body}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <SectionHead eyebrow={s.thesis.eyebrow} heading={s.thesis.heading} body={s.thesis.body} />
    <Items items={s.thesis.items!} cols={4} class="mt-12" />
    <PullQuote class="mt-16" text="The best software for a business is written by someone who has to run it on Monday." />
  </Section>

  <Section tone="surface">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHead eyebrow={s.facts.eyebrow} heading={s.facts.heading} size="t-2" />
        <div class="mt-8 flex flex-col gap-4">
          <Wordmark which="watzaura" size="lg" />
          <Wordmark which="arenzo" size="lg" />
          <p class="max-w-sm text-[0.8125rem] text-muted">Wordmarks set in Fraunces. Arenzo carries the Arch, the same mark as its app icon.</p>
        </div>
      </div>
      <dl class="grid self-start lg:col-span-7">
        {s.facts.items!.map((f) => (
          <div class="grid gap-1 border-t border-line py-4 last:border-b sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="ui-label pt-1">{f.meta}</dt>
            <dd class="text-[1.0625rem] text-ink">
              {f.href ? <a href={f.href} class="link">{f.title}</a> : f.title}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section tight>
    <SectionHead eyebrow={s.contact.eyebrow} heading={s.contact.heading} body={s.contact.body} size="t-2">
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={s.contact.cta!.href} class="btn btn-primary">{s.contact.cta!.label}</a>
        <a href="mailto:hello@watzaura.com" class="btn btn-secondary">hello@watzaura.com</a>
        <a href="tel:+61452551758" class="btn btn-secondary">0452 551 758</a>
      </div>
    </SectionHead>
  </Section>

  <CtaBand />
</Base>
