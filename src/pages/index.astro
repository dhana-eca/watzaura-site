---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import WaitlistForm from '@/components/WaitlistForm.astro';
import RecordView from '@/components/ui/RecordView.astro';
import BookingGrid from '@/components/ui/BookingGrid.astro';
import Pathway from '@/components/ui/Pathway.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import RecordFlow from '@/components/RecordFlow.astro';
import Tiles from '@/components/Tiles.astro';
import PullQuote from '@/components/PullQuote.astro';

const page = (await getEntry('pages', 'home'))!;
const { data } = page;
const s = data.sections;
---

<Base title="Watzaura" description={data.description} product>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} layout="stack" backdrop>
    <RecordView />
    <p class="mt-3 text-[0.75rem] text-muted">Rendered illustration of the product with an invented academy and invented players. Not a screenshot of customer data.</p>
  </Hero>

  <!-- 2. The problem -->
  <Section id="problem">
    <SectionHead eyebrow={s.problem.eyebrow} heading={s.problem.heading} body={s.problem.body} number="01" />
    <Items items={s.problem.items!} cols={3} class="mt-12" />
    <PullQuote class="mt-20" text="One record, from the booking through to the development plan. It is the only thing on this site a competitor cannot also say." />
  </Section>

  <!-- 3. What Plinth joins -->
  <Section id="joins" tone="surface">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHead eyebrow={s.join.eyebrow} heading={s.join.heading} size="t-1" number="02" />
      </div>
      <p class="self-end font-display text-[1.375rem] leading-snug text-ink opsz-48 lg:col-span-5 lg:pb-2">{s.join.body}</p>
    </div>
    <div class="mt-14"><RecordFlow steps={s.join.items!} /></div>
  </Section>

  <!-- 3b. Inside Plinth: tiles -->
  <Section id="inside">
    <SectionHead eyebrow="Inside Plinth" heading="Small things, done properly." body="The pieces an academy touches fifty times a day, as they actually appear. Each one is rendered from the product, with invented names and figures." number="03" />
    <div class="mt-12"><Tiles /></div>
  </Section>

  <!-- 4. Product surfaces with rendered UI -->
  <Section id="product">
    <SectionHead eyebrow={s.surfaces.eyebrow} heading={s.surfaces.heading} number="04" />
    <div class="mt-12 grid gap-16">
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="ui-label mb-3 text-brass">01</p>
          <h3 class="t-2"><a href={s.surfaces.items![0].href} class="transition-colors hover:text-brass-light">{s.surfaces.items![0].title}</a></h3>
          <p class="mt-4 text-[1rem] leading-relaxed text-ink-2">{s.surfaces.items![0].body}</p>
          <a href={s.surfaces.items![0].href} class="link link-arrow mt-5 inline-block">Operations in detail</a>
        </div>
        <div class="lg:col-span-8"><BookingGrid /></div>
      </div>
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="order-2 lg:col-span-8 lg:order-1"><Pathway /></div>
        <div class="order-1 lg:col-span-4 lg:order-2">
          <p class="ui-label mb-3 text-brass">02</p>
          <h3 class="t-2"><a href={s.surfaces.items![1].href} class="transition-colors hover:text-brass-light">{s.surfaces.items![1].title}</a></h3>
          <p class="mt-4 text-[1rem] leading-relaxed text-ink-2">{s.surfaces.items![1].body}</p>
          <a href={s.surfaces.items![1].href} class="link link-arrow mt-5 inline-block">Development in detail</a>
        </div>
      </div>
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="ui-label mb-3 text-brass">03</p>
          <h3 class="t-2"><a href={s.surfaces.items![2].href} class="transition-colors hover:text-brass-light">{s.surfaces.items![2].title}</a></h3>
          <p class="mt-4 text-[1rem] leading-relaxed text-ink-2">{s.surfaces.items![2].body}</p>
          <a href={s.surfaces.items![2].href} class="link link-arrow mt-5 inline-block">Mobile in detail</a>
        </div>
        <div class="flex flex-wrap items-start justify-center gap-6 lg:col-span-8 lg:justify-start lg:pl-8">
          <PhoneFrame view="coach" />
          <PhoneFrame view="parent" class="hidden sm:block sm:translate-y-8" />
        </div>
      </div>
    </div>
  </Section>

  <!-- 5. Built at Elite -->
  <Section id="elite" tone="surface">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <SectionHead eyebrow={s.elite.eyebrow} heading={s.elite.heading} number="05" />
        <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-ink-2">{s.elite.body}</p>
        <a href={s.elite.cta!.href} class="btn btn-secondary mt-7">{s.elite.cta!.label}</a>
      </div>
      <ul class="grid gap-0 self-center lg:col-span-6">
        {s.elite.items!.map((c) => (
          <li class="grid gap-1 border-t border-line py-5 last:border-b sm:grid-cols-[10rem_1fr] sm:gap-6">
            <p class="ui-label pt-1">{c.meta}</p>
            <div>
              <h3 class="t-3 text-ink">{c.title}</h3>
              <p class="mt-1 text-[0.9375rem] text-ink-2">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 6. Who it's for -->
  <Section id="who">
    <SectionHead eyebrow={s.who.eyebrow} heading={s.who.heading} number="06" />
    <Items items={s.who.items!} cols={3} class="mt-12" />
  </Section>

  <!-- 7. Early access -->
  <Section id="early-access" tone="surface">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHead eyebrow={s.access.eyebrow} heading={s.access.heading} />
        <p class="mt-6 max-w-md text-[1.0625rem] leading-relaxed text-ink-2">{s.access.body}</p>
      </div>
      <div class="lg:col-span-7">
        <WaitlistForm id="home-waitlist" />
      </div>
    </div>
  </Section>
</Base>
