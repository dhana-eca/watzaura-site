---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';
import RecordView from '@/components/ui/RecordView.astro';

const { data } = (await getEntry('pages', 'product'))!;
const s = data.sections;
---

<Base title={data.title} description={data.description} product>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} layout="stack">
    <RecordView />
    <p class="mt-3 text-[0.75rem] text-muted">Rendered illustration with an invented academy and invented players. Not a screenshot of customer data.</p>
  </Hero>

  <Section>
    <SectionHead eyebrow={s.record.eyebrow} heading={s.record.heading} body={s.record.body} />
    <Items items={s.record.items!} cols={4} class="mt-12" />
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow={s.surfaces.eyebrow} heading={s.surfaces.heading} />
    <div class="mt-12 grid gap-0">
      {s.surfaces.items!.map((it, i) => (
        <article class="grid gap-6 border-t border-line py-10 last:border-b lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-5">
            <p class="ui-label mb-3 text-brass">{String(i + 1).padStart(2, '0')} · {it.meta}</p>
            <h3 class="t-2"><a href={it.href} class="transition-colors hover:text-brass-light">{it.title}</a></h3>
            <p class="mt-4 text-[1rem] leading-relaxed text-ink-2">{it.body}</p>
            <a href={it.href} class="link link-arrow mt-5 inline-block">{it.title} in detail</a>
          </div>
          <ul class="grid gap-2 self-center lg:col-span-6 lg:col-start-7">
            {it.points!.map((pt) => (
              <li class="flex gap-3 text-[0.9375rem] text-ink-2"><span class="mt-[0.6em] inline-block size-1.5 flex-none bg-brass" aria-hidden="true"></span>{pt}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHead eyebrow={s.foundations.eyebrow} heading={s.foundations.heading} />
    <Items items={s.foundations.items!} cols={2} class="mt-12" />
  </Section>

  <CtaBand />
</Base>
