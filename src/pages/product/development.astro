---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';
import Pathway from '@/components/ui/Pathway.astro';

const { data } = (await getEntry('pages', 'development'))!;
const s = data.sections;
---

<Base title={data.title} description={data.description} product>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} layout="stack" size="t-1">
    <Pathway />
    <p class="mt-3 text-[0.75rem] text-muted">Rendered illustration with an invented academy and invented players. Not a screenshot of customer data.</p>
  </Hero>

  <Section tight>
    <SectionHead eyebrow={s.why.eyebrow} heading={s.why.heading} body={s.why.body} />
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow={s.pathway.eyebrow} heading={s.pathway.heading} />
    <Items items={s.pathway.items!} cols={4} class="mt-12" />
  </Section>

  <Section>
    <SectionHead eyebrow={s.visibility.eyebrow} heading={s.visibility.heading} />
    <Items items={s.visibility.items!} cols={3} class="mt-12" />
  </Section>

  <Section tone="surface" tight>
    <SectionHead eyebrow={s.honest.eyebrow} heading={s.honest.heading} body={s.honest.body} size="t-2">
      <a href={s.honest.cta!.href} class="btn btn-secondary mt-7">{s.honest.cta!.label}</a>
    </SectionHead>
  </Section>

  <CtaBand />
</Base>
