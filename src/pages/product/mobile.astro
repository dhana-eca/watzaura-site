---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import Tabs from '@/components/Tabs.astro';

const people = [
  { id: 'parent', label: 'Parent', blurb: 'Book, pay, manage the membership, read this week’s rating.' },
  { id: 'athlete', label: 'Athlete', blurb: 'The focus for the week, the program, the diary, the next match.' },
  { id: 'coach', label: 'Coach', blurb: 'Today’s roster, attendance, and a rating written from the lane.' },
];

const { data } = (await getEntry('pages', 'mobile'))!;
const s = data.sections;
---

<Base title={data.title} description={data.description} product>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} layout="split" size="t-1">
    <div class="flex items-start justify-center gap-6 lg:justify-end">
      <PhoneFrame view="parent" class="hidden sm:block sm:translate-y-10" />
      <PhoneFrame view="coach" />
    </div>
    <p class="mt-3 text-center text-[0.75rem] text-muted lg:text-right">Rendered illustration with invented players. Not a screenshot of customer data.</p>
  </Hero>

  <Section id="walkthrough">
    <SectionHead eyebrow="Walkthrough" heading="Pick up the phone as each of them." body="Switch between the three people who use Plinth on a phone. Invented names; rendered, not photographed." number="01" />
    <Tabs tabs={people} label="Mobile personas" class="mt-12">
      <div slot="parent" class="flex justify-center lg:justify-start"><PhoneFrame view="parent" /></div>
      <div slot="athlete" class="flex justify-center lg:justify-start"><PhoneFrame view="athlete" /></div>
      <div slot="coach" class="flex justify-center lg:justify-start"><PhoneFrame view="coach" /></div>
    </Tabs>
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow={s.people.eyebrow} heading={s.people.heading} number="02" />
    <Items items={s.people.items!} cols={3} class="mt-12" />
  </Section>

  <Section>
    <SectionHead eyebrow={s.delivery.eyebrow} heading={s.delivery.heading} body={s.delivery.body} number="03" />
    <Items items={s.delivery.items!} cols={4} class="mt-12" />
  </Section>

  <Section tight>
    <SectionHead eyebrow={s.honest.eyebrow} heading={s.honest.heading} body={s.honest.body} size="t-2" />
  </Section>

  <CtaBand />
</Base>
