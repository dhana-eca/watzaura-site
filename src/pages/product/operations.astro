---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Items from '@/components/Items.astro';
import CtaBand from '@/components/CtaBand.astro';
import BookingGrid from '@/components/ui/BookingGrid.astro';
import Membership from '@/components/ui/Membership.astro';
import Tabs from '@/components/Tabs.astro';
import Roster from '@/components/ui/Roster.astro';
import Broadcast from '@/components/ui/Broadcast.astro';
import Reports from '@/components/ui/Reports.astro';

const walk = [
  { id: 'book', label: 'Book', blurb: 'Lanes, machines and coaches on one grid, per centre.' },
  { id: 'roster', label: 'Run the session', blurb: 'Mark attendance, settle credits, flag a plan mismatch without blocking a child.' },
  { id: 'money', label: 'Collect', blurb: 'Direct debits, credit wallets, casual cards — on the family account.' },
  { id: 'comms', label: 'Tell families', blurb: 'Broadcast to a centre; reminders on a schedule, with the log.' },
  { id: 'reports', label: 'See the week', blurb: 'Sales by centre and by day, program rolls, without a spreadsheet.' },
];

const { data } = (await getEntry('pages', 'operations'))!;
const s = data.sections;
---

<Base title={data.title} description={data.description} product>
  <Hero eyebrow={data.eyebrow} heading={data.heading} lede={data.lede} ctas={data.ctas} layout="stack" size="t-1">
    <BookingGrid />
    <p class="mt-3 text-[0.75rem] text-muted">Rendered illustration with an invented academy and invented players. Not a screenshot of customer data.</p>
  </Hero>

  <Section id="walkthrough">
    <SectionHead eyebrow="Walkthrough" heading="A Tuesday at one centre, in five screens." body="Click through the day as the front desk sees it. Every screen is rendered from the product with invented names and figures." number="01" />
    <Tabs tabs={walk} label="Operations walkthrough" class="mt-12">
      <div slot="book"><BookingGrid /></div>
      <div slot="roster"><Roster /></div>
      <div slot="money"><Membership /></div>
      <div slot="comms"><Broadcast /></div>
      <div slot="reports"><Reports /></div>
    </Tabs>
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow={s.bookings.eyebrow} heading={s.bookings.heading} body={s.bookings.body} number="02" />
    <Items items={s.bookings.items!} cols={4} class="mt-12" />
  </Section>

  <Section>
    <SectionHead eyebrow={s.money.eyebrow} heading={s.money.heading} body={s.money.body} number="03" />
    <Items items={s.money.items!} cols={4} class="mt-12" />
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow={s.comms.eyebrow} heading={s.comms.heading} number="04" />
    <Items items={s.comms.items!} cols={3} class="mt-12" />
  </Section>

  <Section tight>
    <div class="grid gap-8 lg:grid-cols-2">
      <SectionHead eyebrow={s.reports.eyebrow} heading={s.reports.heading} body={s.reports.body} size="t-2" />
      <SectionHead eyebrow={s.onerecord.eyebrow} heading={s.onerecord.heading} body={s.onerecord.body} size="t-2">
        <a href={s.onerecord.cta!.href} class="link link-arrow mt-5 inline-block">{s.onerecord.cta!.label}</a>
      </SectionHead>
    </div>
  </Section>

  <CtaBand />
</Base>
