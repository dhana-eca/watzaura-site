# Waitlist endpoint (POST /api/waitlist). Without these the endpoint answers
# 503 and the form shows an honest "not open yet" message — it never fakes success.

# Postgres connection string. Run `npm run db:migrate` once to create the table.
DATABASE_URL=postgres://user:password@host:5432/watzaura

# Resend API key (https://resend.com). The sending domain must be verified.
RESEND_API_KEY=re_xxxxxxxxx

# Sender and internal notification address. Sender must be on the verified domain.
WAITLIST_FROM="Watzaura <hello@watzaura.com>"
WAITLIST_NOTIFY=hello@watzaura.com

# Optional: comma-separated origins allowed to POST (defaults to the site origin).
# WAITLIST_ALLOWED_ORIGINS=https://watzaura.com,https://www.watzaura.com

# Port the Node server listens on (Render sets this automatically).
# PORT=4321
